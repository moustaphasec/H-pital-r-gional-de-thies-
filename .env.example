# Optionnel : Clé Google Gemini API (format AIza...) pour enrichir l'assistant médical IA en ligne.
# Sans cette clé (ou hors-ligne), le moteur expert médical local intégré prend automatiquement le relais !
VITE_GEMINI_API_KEY=""

# Optionnel : Surcharge de la configuration Firebase (par défaut configurée sur le projet officiel)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optionnel : Surcharge EmailJS pour les notifications e-mail aux patients ayant fourni une adresse
VITE_EMAILJS_PUBLIC_KEY=""
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_CONFIRM_TEMPLATE_ID=""
VITE_EMAILJS_CANCEL_TEMPLATE_ID=""
